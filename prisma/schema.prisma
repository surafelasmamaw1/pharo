// Prisma Schema for Pharo Foundation Website Backend
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Student Admissions Application Model
model Application {
  id            String   @id @default(uuid())
  applicantName String
  parentName    String?
  email         String
  phone         String
  gradeLevel    String
  program       String?
  notes          String?
  age            String?
  gender         String?
  previousSchool String?
  emergencyPhone String?
  city           String?
  status         String   @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED
  createdAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Contact Inquiry Messages Model
model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt DateTime @default(now())
}

// Dynamic News & Events Announcement Model
model NewsEvent {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   @default("News") // News, Events, Academic, Activity
  snippet     String
  content     String
  date        String
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Site-Wide Settings & Urgent Banner Model
model SiteSetting {
  id                 String   @id @default("default")
  urgentBannerActive Boolean  @default(false)
  urgentBannerText   String?  @default("")
  tuitionFeeText     String?  @default("ETB 9,700")
  admissionDeadline  String?  @default("Rolling Admissions")
  contactPhone       String?  @default("+251 91 234 5678")
  contactEmail       String?  @default("admissions@pharoschool.edu.et")
  updatedAt          DateTime @updatedAt
}

// Community Testimonials & Reviews Model
model Testimonial {
  id        String   @id @default(uuid())
  type      String   @default("Parent") // Parent, Student, Teacher
  name      String
  role      String
  quote     String
  createdAt DateTime @default(now())
}

// School Photo Gallery Model
model GalleryItem {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("Campus") // Campus, Sports, Academics, Events
  imageUrl  String
  createdAt DateTime @default(now())
}

// Faculty & Academic Leadership Model
model FacultyMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  credentials String
  bio         String
  expertise   String   @default("") // Comma-separated tags
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

