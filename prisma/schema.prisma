// Prisma Schema for Pharo Foundation Website Backend
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Student Admissions Application Model
model Application {
  id            String   @id @default(uuid())
  applicantName String
  parentName    String?
  email         String
  phone         String
  gradeLevel    String
  program       String?
  notes          String?
  age            String?
  gender         String?
  previousSchool String?
  emergencyPhone String?
  city           String?
  status         String   @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED
  createdAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Contact Inquiry Messages Model
model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt DateTime @default(now())
}

// Dynamic News & Events Announcement Model
model NewsEvent {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   @default("News") // News, Events, Academic, Activity
  snippet     String
  content     String
  date        String
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
